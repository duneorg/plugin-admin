  "tasks": {
    "test": "deno test -A tests/",
    "test:e2e": "deno run --allow-all --unstable-kv npm:playwright test --config playwright.config.ts",
    "test:e2e:install": "deno run --allow-all npm:playwright install chromium",
    "gen:admin-manifest": "deno run --allow-read --allow-write scripts/generate-admin-manifest.ts",
    "gen:core-imports": "deno run --allow-read --allow-write scripts/generate-core-imports.ts",
    "check:core-imports": "deno run --allow-read scripts/generate-core-imports.ts --check"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "require-await",
        "no-import-prefix"
      ]
    }
  }
}
