  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./admin/mount": "./src/admin/mount.ts",
    "./admin/context": "./src/admin/context.ts",
    "./admin/types": "./src/admin/types.ts",
    "./admin/auth/middleware": "./src/admin/auth/middleware.ts",
    "./admin/auth/provider": "./src/admin/auth/provider.ts"
  },
  "imports": {
    "@dune/core/audit": "jsr:@dune/core@0/audit",
    "@dune/core/auth/authz": "jsr:@dune/core@0/auth/authz",
    "@dune/core/auth/authz-adapter-db": "jsr:@dune/core@0/auth/authz-adapter-db",
    "@dune/core/auth/authz-adapter-local": "jsr:@dune/core@0/auth/authz-adapter-local",
    "@dune/core/blueprints": "jsr:@dune/core@0/blueprints",
    "@dune/core/bootstrap": "jsr:@dune/core@0/bootstrap",
    "@dune/core/config": "jsr:@dune/core@0/config",
    "@dune/core/content/page-loader": "jsr:@dune/core@0/content/page-loader",
    "@dune/core/content/path-utils": "jsr:@dune/core@0/content/path-utils",
    "@dune/core/content/types": "jsr:@dune/core@0/content/types",
