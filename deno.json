    "@dune/core/flex": "jsr:@dune/core@0/flex",
    "@dune/core/forms": "jsr:@dune/core@0/forms",
    "@dune/core/history": "jsr:@dune/core@0/history",
    "@dune/core/hooks": "jsr:@dune/core@0/hooks",
    "@dune/core/i18n": "jsr:@dune/core@0/i18n",
